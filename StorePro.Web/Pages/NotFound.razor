@page "/not-found"
@layout MainLayout

<div class="section-card pa-8 text-center">
    <MudText Typo="Typo.h2" Style="color:var(--sp-primary);font-weight:700;">404</MudText>
    <MudText Typo="Typo.h6" Class="mb-2">Página no encontrada</MudText>
    <MudText Typo="Typo.body2" Class="cell-muted mb-4">
        Lo sentimos, el contenido que busca no existe o fue movido.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="text-none">
        Volver al Panel
    </MudButton>
</div>
